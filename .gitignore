# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# uploaded files (served from backend, not the frontend public/ folder)
/uploads/*
!/uploads/categories
!/uploads/partners
!/uploads/listings
!/uploads/events
/uploads/categories/*
/uploads/partners/*
/uploads/listings/*
/uploads/events/*
!/uploads/categories/.gitkeep
!/uploads/partners/.gitkeep
!/uploads/listings/.gitkeep
!/uploads/events/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts
